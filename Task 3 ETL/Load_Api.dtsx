                          dataType="System.String"><![CDATA[using System;
using System.Collections.Generic;
using System.Data;
using System.Net;
using System.Web.Script.Serialization;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    public override void CreateNewOutputRows()
    {
        using (WebClient client = new WebClient())
        {
            string json = client.DownloadString("https://dummyjson.com/products?limit=0");

            JavaScriptSerializer serializer = new JavaScriptSerializer();
            serializer.MaxJsonLength = Int32.MaxValue;
            var result = serializer.Deserialize<Dictionary<string, object>>(json);
            var products = (System.Collections.ArrayList)result["products"];

            foreach (Dictionary<string, object> product in products)
            {
                Output0Buffer.AddRow();

                Output0Buffer.ProductID = product.ContainsKey("id") ? Convert.ToInt32(product["id"]) : 0;
                Output0Buffer.Title = product.ContainsKey("title") ? product["title"].ToString() : "";
                Output0Buffer.Description = product.ContainsKey("description") ? product["description"].ToString() : "";
                Output0Buffer.Category = product.ContainsKey("category") ? product["category"].ToString() : "";
                Output0Buffer.Price = product.ContainsKey("price") ? Convert.ToDecimal(product["price"]) : 0;
                Output0Buffer.DiscountPercentage = product.ContainsKey("discountPercentage") ? Convert.ToDecimal(product["discountPercentage"]) : 0;
                Output0Buffer.Rating = product.ContainsKey("rating") ? Convert.ToDecimal(product["rating"]) : 0;
                Output0Buffer.Stock = product.ContainsKey("stock") ? Convert.ToInt32(product["stock"]) : 0;
                Output0Buffer.Brand = product.ContainsKey("brand") ? product["brand"].ToString() : "N/A";
                Output0Buffer.SKU = product.ContainsKey("sku") ? product["sku"].ToString() : "";
                Output0Buffer.Weight = product.ContainsKey("weight") ? Convert.ToInt32(product["weight"]) : 0;
                Output0Buffer.WarrantyInformation = product.ContainsKey("warrantyInformation") ? product["warrantyInformation"].ToString() : "";
                Output0Buffer.ShippingInformation = product.ContainsKey("shippingInformation") ? product["shippingInformation"].ToString() : "";
                Output0Buffer.AvailabilityStatus = product.ContainsKey("availabilityStatus") ? product["availabilityStatus"].ToString() : "";
                Output0Buffer.ReturnPolicy = product.ContainsKey("returnPolicy") ? product["returnPolicy"].ToString() : "";
                Output0Buffer.MinimumOrderQuantity = product.ContainsKey("minimumOrderQuantity") ? Convert.ToInt32(product["minimumOrderQuantity"]) : 0;
            }
        }
    }
}]]></arrayElement>
