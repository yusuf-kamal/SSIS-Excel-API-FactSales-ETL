                        <arrayElement
                          dataType="System.String"><![CDATA[using System;
using System.Collections.Generic;
using System.Net;
using System.Web.Script.Serialization;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    public override void CreateNewOutputRows()
    {
        using (WebClient client = new WebClient())
        {
            string json = client.DownloadString("https://dummyjson.com/products?limit=0");

            JavaScriptSerializer serializer = new JavaScriptSerializer();
            serializer.MaxJsonLength = Int32.MaxValue;

            var result = serializer.Deserialize<Dictionary<string, object>>(json);
            var products = (System.Collections.ArrayList)result["products"];

            foreach (Dictionary<string, object> product in products)
            {
                int productId = Convert.ToInt32(product["id"]);

                if (product.ContainsKey("reviews") && product["reviews"] != null)
                {
                    var reviews = (System.Collections.ArrayList)product["reviews"];

                    foreach (Dictionary<string, object> review in reviews)
                    {
                        Output0Buffer.AddRow();

                        Output0Buffer.ProductID = productId;

                        Output0Buffer.Rating =
                            review.ContainsKey("rating")
                            ? Convert.ToInt32(review["rating"])
                            : 0;

                        Output0Buffer.Comment =
                            review.ContainsKey("comment")
                            ? review["comment"].ToString()
                            : "";

                        Output0Buffer.ReviewDate =
                            review.ContainsKey("date")
                            ? Convert.ToDateTime(review["date"])
                            : DateTime.MinValue;

                        Output0Buffer.ReviewerName =
                            review.ContainsKey("reviewerName")
                            ? review["reviewerName"].ToString()
                            : "";

                        Output0Buffer.ReviewerEmail =
                            review.ContainsKey("reviewerEmail")
                            ? review["reviewerEmail"].ToString()
                            : "";
                    }
                }
            }
        }
    }
}]]></arrayElement>
